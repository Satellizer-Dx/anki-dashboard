generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SyncSnapshot {
  id        Int      @id @default(autoincrement())
  timestamp DateTime

  decks     DeckStat[]
}

model DeckStat {
  id           Int      @id @default(autoincrement())

  deckId       BigInt
  name         String

  newCount     Int
  learnCount   Int
  reviewCount  Int
  totalInDeck  Int

  snapshotId   Int
  snapshot     SyncSnapshot @relation(fields: [snapshotId], references: [id])
}